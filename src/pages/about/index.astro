---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---

<Base title={`About Us | ${site.name}`} description={`Learn about ${site.name} — locally owned landscaping company serving ${site.city}, ${site.state} and the Triangle. Licensed, insured, and committed to quality.`}>
  <section class="about-hero">
    <div class="container">
      <p class="section-label">About Us</p>
      <h1>Your Local Landscaping Team</h1>
      <p class="about-hero-sub">
        We're a locally owned landscaping company rooted in the Raleigh-Durham area. We treat every
        property like our own — because our reputation depends on it.
      </p>
    </div>
  </section>

  <section class="about-content">
    <div class="container">
      <div class="about-grid">
        <div class="about-main">
          <h2>Built on Quality Work & Honest Service</h2>
          <p>
            We started this company because we saw too many homeowners getting inconsistent service,
            surprise charges, and crews that never showed up on time. We believe landscaping should be
            simple: clear pricing, reliable scheduling, and work that speaks for itself.
          </p>
          <p>
            Every crew member on our team is trained, insured, and equipped with commercial-grade
            equipment. We don't cut corners — we cut clean edges, install proper drainage, and use
            the right plants for Raleigh's climate. Whether it's weekly mowing or a full landscape
            renovation, we bring the same attention to detail.
          </p>
          <p>
            We serve all of Wake County and parts of Durham and Johnston counties. From downtown
            Raleigh to the growing communities of Holly Springs, Apex, and Wake Forest — if you're
            in the Triangle, we've got you covered.
          </p>

          <h3>What Sets Us Apart</h3>
          <div class="about-values">
            {site.whyUs.map((item, i) => (
              <div class="about-value">
                <span class="about-value-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{item.title}</strong>
                  <p>{item.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <aside class="about-sidebar">
          <div class="sidebar-cta">
            <h3>Ready to Get Started?</h3>
            <p>Call us or request a free estimate online.</p>
            <a href={`tel:${site.phoneTel}`} class="btn btn-primary" style="width:100%;justify-content:center;">
              {site.phone}
            </a>
            <a href="/contact/" class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:8px;">
              Contact Us
            </a>
          </div>

          <div class="sidebar-quick-facts">
            <h4>Quick Facts</h4>
            <ul>
              <li><strong>Based in:</strong> Raleigh, NC</li>
              <li><strong>Service Area:</strong> Wake, Durham & Johnston Counties</li>
              <li><strong>Hours:</strong> {site.hours}</li>
              <li><strong>Licensed & Insured:</strong> Yes</li>
              <li><strong>Free Estimates:</strong> Yes</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    background: var(--bg-dark);
    padding: 80px 0 88px;
    position: relative;
    overflow: hidden;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 40% 60%, rgba(61,107,61,0.1), transparent 55%);
  }
  .about-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .about-hero .container { position: relative; }
  .about-hero .section-label { color: var(--warm); }
  .about-hero h1 {
    font-size: clamp(34px, 4.5vw, 50px);
    color: var(--white);
    margin-bottom: 18px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }
  .about-hero-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    max-width: 560px;
    line-height: 1.75;
    font-weight: 300;
  }

  .about-content { padding: 80px 0 104px; }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 56px;
    align-items: start;
  }
  .about-main h2 { font-size: 30px; margin-bottom: 18px; letter-spacing: -0.3px; }
  .about-main > p {
    font-size: 16px;
    line-height: 1.85;
    margin-bottom: 20px;
    color: var(--text);
    font-weight: 300;
  }
  .about-main h3 {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    margin: 36px 0 22px;
    letter-spacing: -0.1px;
  }
  .about-values { display: flex; flex-direction: column; gap: 14px; }
  .about-value {
    display: flex;
    gap: 16px;
    padding: 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s;
  }
  .about-value:hover { border-color: rgba(61,107,61,0.15); }
  .about-value-num {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    color: rgba(184,121,64,0.2);
    flex-shrink: 0;
    line-height: 1;
    padding-top: 2px;
  }
  .about-value strong { display: block; font-size: 15px; margin-bottom: 4px; font-weight: 600; }
  .about-value p { font-size: 14px; color: var(--text-light); line-height: 1.65; margin: 0; font-weight: 300; }

  .sidebar-cta {
    background: var(--bg-card);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 24px;
  }
  .sidebar-cta h3 { font-family: var(--font-body); font-size: 17px; font-weight: 600; margin-bottom: 8px; }
  .sidebar-cta p { font-size: 14px; color: var(--text-light); margin-bottom: 16px; font-weight: 300; }
  .sidebar-quick-facts {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .sidebar-quick-facts h4 {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
    color: var(--text-light);
  }
  .sidebar-quick-facts ul { list-style: none; }
  .sidebar-quick-facts li {
    padding: 9px 0;
    font-size: 14px;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }
  .sidebar-quick-facts li:last-child { border-bottom: none; }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
