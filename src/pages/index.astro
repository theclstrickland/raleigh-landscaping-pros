---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`${site.name} | ${site.tagline} in ${site.city}, ${site.state}`} description={site.description}>

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-content">
          <p class="section-label">Raleigh's Trusted Landscaping Team</p>
          <h1>Professional Landscaping<br/>for the Triangle</h1>
          <p class="hero-sub">
            From weekly lawn care to full landscape transformations — we keep Raleigh properties
            looking their best. Licensed, insured, and locally owned.
          </p>
          <div class="hero-actions">
            <a href={`tel:${site.phoneTel}`} class="btn btn-primary">Call {site.phone}</a>
            <a href="/contact/" class="btn btn-secondary">Get Free Estimate</a>
          </div>
          <div class="hero-trust">
            <div class="trust-item"><span class="trust-bar"></span>Licensed & Insured</div>
            <div class="trust-item"><span class="trust-bar"></span>Free Estimates</div>
            <div class="trust-item"><span class="trust-bar"></span>Locally Owned</div>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-card">
            <div class="hero-card-line"></div>
            <div class="hero-card-text">
              <strong>Serving the Triangle</strong>
              <span>Raleigh &middot; Cary &middot; Apex &middot; Wake Forest & more</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SERVICES ── -->
  <section class="services" id="services">
    <div class="container">
      <p class="section-label">What We Do</p>
      <h2>Our Services</h2>
      <p class="section-intro">Everything your property needs — from routine maintenance to major installations.</p>
      <div class="services-grid">
        {site.services.map((s, i) => (
          <a href={`/${s.slug}/`} class="service-card">
            <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="service-link">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHY US ── -->
  <section class="why" id="why">
    <div class="container">
      <p class="section-label">Why Choose Us</p>
      <h2>The Raleigh Landscaping Difference</h2>
      <div class="why-grid">
        {site.whyUs.map((item, i) => (
          <div class="why-card">
            <span class="why-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PRICING ── -->
  <section class="pricing" id="pricing">
    <div class="container">
      <p class="section-label">Transparent Pricing</p>
      <h2>What Landscaping Costs in Raleigh</h2>
      <p class="section-intro">Every property is different, but here are typical ranges for our most popular services.</p>
      <div class="pricing-table-wrap">
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Service</th>
              <th>Typical Price Range</th>
            </tr>
          </thead>
          <tbody>
            {site.pricing.map(row => (
              <tr>
                <td>{row.service}</td>
                <td class="price-cell">{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pricing-note">
        Prices vary based on property size, condition, and scope. Call <a href={`tel:${site.phoneTel}`}>{site.phone}</a> for a free, detailed estimate.
      </p>
    </div>
  </section>

  <!-- ── LOCATIONS ── -->
  <section class="locations" id="locations">
    <div class="container">
      <p class="section-label">Areas We Serve</p>
      <h2>Landscaping Across the Triangle</h2>
      <div class="locations-grid">
        <a href="/#services" class="location-card location-primary">
          <span class="location-name">Raleigh</span>
          <span class="location-county">Wake County</span>
        </a>
        {site.locations.map(loc => (
          <a href={`/${loc.slug}/`} class="location-card">
            <span class="location-name">{loc.name}</span>
            <span class="location-county">{loc.county} County</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="faq" id="faq">
    <div class="container">
      <p class="section-label">Common Questions</p>
      <h2>Frequently Asked Questions</h2>
      <div class="faq-list">
        {site.faqs.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": site.faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <!-- ── FINAL CTA ── -->
  <section class="final-cta">
    <div class="container">
      <h2>Ready to Transform Your Yard?</h2>
      <p>Get a free estimate from Raleigh's trusted landscaping team. No pressure, no commitment.</p>
      <div class="final-actions">
        <a href={`tel:${site.phoneTel}`} class="btn btn-primary">Call {site.phone}</a>
        <a href="/contact/" class="btn btn-secondary">Request Estimate Online</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--bg-dark);
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/hero.jpg') center/cover no-repeat;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(20,30,18,0.88) 0%, rgba(20,30,18,0.75) 45%, rgba(20,30,18,0.45) 100%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 64px;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .hero .section-label { color: var(--warm); }
  .hero h1 {
    font-size: clamp(38px, 5.5vw, 60px);
    color: var(--white);
    margin-bottom: 22px;
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.5px;
  }
  .hero-sub {
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    margin-bottom: 36px;
    max-width: 500px;
    line-height: 1.75;
    font-weight: 300;
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 40px; }
  .hero-trust { display: flex; gap: 28px; flex-wrap: wrap; }
  .trust-item {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 400;
    letter-spacing: 0.2px;
  }
  .trust-bar {
    display: block;
    width: 16px;
    height: 1.5px;
    background: var(--warm);
  }
  .hero-visual { display: flex; justify-content: center; }
  .hero-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .hero-card-line {
    width: 3px;
    height: 48px;
    background: linear-gradient(to bottom, var(--accent), var(--warm));
    border-radius: 2px;
    flex-shrink: 0;
  }
  .hero-card-text strong {
    display: block;
    color: var(--white);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .hero-card-text span {
    color: rgba(255,255,255,0.4);
    font-size: 13px;
    letter-spacing: 0.3px;
  }

  /* ── Services ── */
  .services { padding: 104px 0; }
  .services h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 8px; }
  .section-intro {
    color: var(--text-light);
    font-size: 16px;
    margin-bottom: 56px;
    max-width: 520px;
    font-weight: 300;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .service-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: rgba(61,107,61,0.2);
  }
  .service-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    color: rgba(61,107,61,0.15);
    display: block;
    margin-bottom: 16px;
    line-height: 1;
  }
  .service-card h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 10px;
    letter-spacing: -0.1px;
  }
  .service-card p { font-size: 14px; color: var(--text-light); line-height: 1.65; margin-bottom: 20px; font-weight: 300; }
  .service-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.2px;
  }

  /* ── Why ── */
  .why { padding: 104px 0; background: var(--bg-alt); position: relative; }
  .why::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .why .container { position: relative; }
  .why h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 56px; }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .why-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
  }
  .why-num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 400;
    color: rgba(184,121,64,0.2);
    display: block;
    margin-bottom: 12px;
    line-height: 1;
  }
  .why-card h3 {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.1px;
  }
  .why-card p { font-size: 14px; color: var(--text-light); line-height: 1.65; font-weight: 300; }

  /* ── Pricing ── */
  .pricing { padding: 104px 0; }
  .pricing h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 8px; }
  .pricing-table-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .pricing-table th {
    text-align: left;
    padding: 16px 28px;
    background: var(--bg-dark);
    color: rgba(255,255,255,0.6);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .pricing-table td {
    padding: 15px 28px;
    border-bottom: 1px solid var(--border);
    font-weight: 400;
  }
  .pricing-table tr:last-child td { border-bottom: none; }
  .pricing-table tr:hover td { background: var(--accent-light); }
  .price-cell { font-weight: 600; color: var(--accent); font-family: var(--font-body); }
  .pricing-note {
    font-size: 14px;
    color: var(--text-light);
    font-weight: 300;
  }
  .pricing-note a { color: var(--accent); font-weight: 500; }

  /* ── Locations ── */
  .locations { padding: 104px 0; background: var(--bg-alt); }
  .locations h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 56px; }
  .locations-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .location-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    text-decoration: none;
    transition: all 0.25s;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .location-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow); }
  .location-primary {
    background: var(--accent);
    border-color: var(--accent);
  }
  .location-primary .location-name { color: var(--white); }
  .location-primary .location-county { color: rgba(255,255,255,0.65); }
  .location-name { font-weight: 600; font-size: 15px; }
  .location-county { font-size: 12px; color: var(--text-light); letter-spacing: 0.2px; }

  /* ── FAQ ── */
  .faq { padding: 104px 0; }
  .faq h2 { font-size: clamp(30px, 4vw, 44px); margin-bottom: 56px; }
  .faq-list { max-width: 700px; }
  .faq-item {
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-item summary {
    padding: 22px 0;
    font-weight: 500;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s;
    letter-spacing: -0.1px;
  }
  .faq-item summary:hover { color: var(--accent); }
  .faq-item summary::after {
    content: '+';
    font-size: 22px;
    font-weight: 300;
    color: var(--text-light);
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: 16px;
  }
  .faq-item[open] summary::after { content: '\2212'; transform: rotate(180deg); }
  .faq-item p {
    padding: 0 0 24px;
    font-size: 15px;
    color: var(--text-light);
    line-height: 1.75;
    font-weight: 300;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--bg-dark);
    padding: 88px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .final-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 50%, rgba(61,107,61,0.1), transparent 60%);
  }
  .final-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .final-cta .container { position: relative; }
  .final-cta h2 {
    color: var(--white);
    font-size: clamp(30px, 4vw, 44px);
    margin-bottom: 16px;
  }
  .final-cta p {
    color: rgba(255,255,255,0.55);
    font-size: 17px;
    margin-bottom: 36px;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 300;
    line-height: 1.7;
  }
  .final-actions { display: flex; justify-content: center; gap: 16px; flex-wrap: wrap; }
  .final-cta .btn-secondary {
    border-color: rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
  }
  .final-cta .btn-secondary:hover { background: rgba(255,255,255,0.06); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .hero-visual { display: none; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    .why-grid { grid-template-columns: 1fr 1fr; }
    .locations-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .locations-grid { grid-template-columns: 1fr; }
    .hero { padding: 64px 0 80px; }
  }
</style>
