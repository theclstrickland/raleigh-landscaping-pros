---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  name: string;
  slug: string;
  county: string;
  description: string;
}

const { name, slug, county, description } = Astro.props;
const otherLocations = site.locations.filter(l => l.slug !== slug);
---

<Base
  title={`Landscaping in ${name}, ${site.state} | ${site.name}`}
  description={`Professional landscaping, lawn care, and hardscaping in ${name}, ${site.state}. Serving ${county} County. Free estimates. Call ${site.phone}.`}
>
  <section class="lp-hero">
    <div class="container">
      <p class="section-label">{county} County</p>
      <h1>Landscaping Services in {name}, {site.state}</h1>
      <p class="lp-hero-sub">{description}</p>
      <div class="lp-hero-actions">
        <a href={`tel:${site.phoneTel}`} class="btn btn-primary">📞 Call {site.phone}</a>
        <a href="/contact/" class="btn btn-secondary">Get Free Estimate</a>
      </div>
    </div>
  </section>

  <section class="lp-services">
    <div class="container">
      <h2>Our Services in {name}</h2>
      <p class="section-intro">We bring the same professional-grade service to {name} that we deliver across the Raleigh metro.</p>
      <div class="lp-services-grid">
        {site.services.map(s => (
          <a href={`/${s.slug}/`} class="lp-service-card">
            <span class="lp-service-icon">{s.icon}</span>
            <div>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-areas">
    <div class="container">
      <h2>Other Areas We Serve</h2>
      <div class="lp-areas-grid">
        <a href="/" class="lp-area-pill lp-area-primary">Raleigh</a>
        {otherLocations.map(loc => (
          <a href={`/${loc.slug}/`} class="lp-area-pill">{loc.name}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-cta">
    <div class="container">
      <h2>Need Landscaping in {name}?</h2>
      <p>Call today for a free estimate. We'll come to your property, walk the site, and give you a detailed quote.</p>
      <a href={`tel:${site.phoneTel}`} class="btn btn-primary">📞 {site.phone}</a>
    </div>
  </section>
</Base>

<style>
  .lp-hero {
    background: var(--bg-dark);
    padding: 72px 0 80px;
    position: relative;
  }
  .lp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 30%, rgba(45, 106, 48, 0.12), transparent 60%);
  }
  .lp-hero .container { position: relative; }
  .lp-hero .section-label { color: var(--warm); }
  .lp-hero h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    color: var(--white);
    margin-bottom: 16px;
    max-width: 700px;
  }
  .lp-hero-sub {
    font-size: 17px;
    color: rgba(255,255,255,0.7);
    max-width: 600px;
    margin-bottom: 28px;
    line-height: 1.7;
  }
  .lp-hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .lp-hero .btn-secondary { border-color: rgba(255,255,255,0.3); color: var(--white); }

  .lp-services { padding: 80px 0; }
  .lp-services h2 { font-size: clamp(28px, 4vw, 36px); margin-bottom: 8px; }
  .lp-services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .lp-service-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    gap: 16px;
    align-items: start;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s;
  }
  .lp-service-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .lp-service-icon { font-size: 32px; flex-shrink: 0; }
  .lp-service-card h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .lp-service-card p { font-size: 14px; color: var(--text-light); line-height: 1.6; }

  .lp-areas { padding: 64px 0; background: var(--bg-alt); }
  .lp-areas h2 { font-size: 28px; margin-bottom: 24px; }
  .lp-areas-grid { display: flex; flex-wrap: wrap; gap: 12px; }
  .lp-area-pill {
    padding: 10px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: var(--text);
    transition: all 0.2s;
  }
  .lp-area-pill:hover { border-color: var(--accent); color: var(--accent); }
  .lp-area-primary { background: var(--accent); color: var(--white); border-color: var(--accent); }

  .lp-cta {
    background: var(--bg-dark);
    padding: 64px 0;
    text-align: center;
  }
  .lp-cta h2 { color: var(--white); font-size: clamp(24px, 3.5vw, 36px); margin-bottom: 12px; }
  .lp-cta p { color: rgba(255,255,255,0.7); margin-bottom: 24px; max-width: 520px; margin-left: auto; margin-right: auto; }

  @media (max-width: 600px) {
    .lp-services-grid { grid-template-columns: 1fr; }
  }
</style>
