---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, site.url).toString();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={site.name} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "name": site.name,
    "description": site.description,
    "url": site.url,
    "telephone": site.phone,
    "areaServed": [
      { "@type": "City", "name": "Raleigh", "containedInPlace": { "@type": "State", "name": "North Carolina" } },
      ...site.locations.map(loc => ({ "@type": "City", "name": loc.name, "containedInPlace": { "@type": "State", "name": "North Carolina" } }))
    ],
    "openingHours": "Mo-Sa 07:00-18:00",
    "priceRange": "$$",
    "geo": { "@type": "GeoCoordinates", "latitude": site.geo.lat, "longitude": site.geo.lng },
    "address": { "@type": "PostalAddress", "addressLocality": site.city, "addressRegion": site.state }
  })} />
</head>

<body>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand"><img src="/logo.svg" alt="Raleigh Landscaping Pros" class="nav-logo" /></a>
      <button class="nav-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links">
        <li class="nav-dropdown">
          <a href="/#services" class="nav-dropdown-trigger">Services <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="nav-dropdown-menu">
            {site.services.map(s => (
              <a href={`/${s.slug}/`} class="nav-dropdown-item">{s.name}</a>
            ))}
          </div>
        </li>
        <li class="nav-dropdown">
          <a href="/#locations" class="nav-dropdown-trigger">Areas <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="nav-dropdown-menu">
            <a href="/#locations" class="nav-dropdown-item">Raleigh</a>
            {site.locations.map(loc => (
              <a href={`/${loc.slug}/`} class="nav-dropdown-item">{loc.name}</a>
            ))}
          </div>
        </li>
        <li><a href="/#pricing">Pricing</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href={`tel:${site.phoneTel}`} class="nav-cta">{site.phone}</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <img src="/logo.svg" alt="Raleigh Landscaping Pros" class="footer-logo" />
          <p class="footer-desc">{site.description}</p>
          <a href={`tel:${site.phoneTel}`} class="btn btn-primary">{site.phone}</a>
        </div>
        <div>
          <h4>Services</h4>
          <ul class="footer-links">
            {site.services.map(s => (
              <li><a href={`/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4>Areas We Serve</h4>
          <ul class="footer-links">
            <li><a href="/#locations">Raleigh</a></li>
            {site.locations.map(loc => (
              <li><a href={`/${loc.slug}/`}>{loc.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul class="footer-links">
            <li><a href="/about/">About Us</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
        <p>{site.disclaimer}</p>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');
    toggle?.addEventListener('click', () => links?.classList.toggle('active'));

    // Mobile dropdown toggles
    document.querySelectorAll('.nav-dropdown-trigger').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
          e.preventDefault();
          const parent = trigger.closest('.nav-dropdown');
          parent?.classList.toggle('mobile-open');
        }
      });
    });
  </script>
</body>
</html>
