---
import Base from './Base.astro';
import { site } from '../data/site';

interface Props {
  name: string;
  slug: string;
  headline: string;
  intro: string;
  body: string;
  benefits: string[];
  priceRange: string;
}

const { name, slug, headline, intro, body, benefits, priceRange } = Astro.props;
const otherServices = site.services.filter(s => s.slug !== slug);
---

<Base
  title={`${name} in ${site.city}, ${site.state} | ${site.name}`}
  description={`Professional ${name.toLowerCase()} in ${site.city}, ${site.state}. ${intro.slice(0, 120)}`}
>
  <section class="sp-hero">
    <div class="container">
      <p class="section-label">{site.name}</p>
      <h1>{headline}</h1>
      <p class="sp-hero-sub">{intro}</p>
      <div class="sp-hero-actions">
        <a href={`tel:${site.phoneTel}`} class="btn btn-primary">Call {site.phone}</a>
        <a href="/contact/" class="btn btn-secondary">Get Free Estimate</a>
      </div>
    </div>
  </section>

  <section class="sp-content">
    <div class="container">
      <div class="sp-grid">
        <div class="sp-main">
          <h2>About Our {name} Service</h2>
          <p>{body}</p>

          <h3>What's Included</h3>
          <ul class="sp-benefits">
            {benefits.map(b => (
              <li><span class="benefit-dash"></span> {b}</li>
            ))}
          </ul>

          <div class="sp-price-box">
            <span class="sp-price-label">Typical Price Range</span>
            <span class="sp-price-value">{priceRange}</span>
            <span class="sp-price-note">Final price depends on property size, condition, and scope.</span>
          </div>
        </div>

        <aside class="sp-sidebar">
          <div class="sidebar-cta">
            <h3>Get a Free Estimate</h3>
            <p>Call us or request an estimate online. No obligation.</p>
            <a href={`tel:${site.phoneTel}`} class="btn btn-primary" style="width:100%;justify-content:center;">
              {site.phone}
            </a>
            <a href="/contact/" class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:8px;">
              Contact Form
            </a>
          </div>

          <div class="sidebar-services">
            <h4>Other Services</h4>
            <ul>
              {otherServices.map(s => (
                <li><a href={`/${s.slug}/`}>{s.name}</a></li>
              ))}
            </ul>
          </div>

          <div class="sidebar-areas">
            <h4>Areas We Serve</h4>
            <ul>
              <li><strong>Raleigh</strong></li>
              {site.locations.map(loc => (
                <li><a href={`/${loc.slug}/`}>{loc.name}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="sp-cta-bottom">
    <div class="container">
      <h2>Need {name} in {site.city}?</h2>
      <p>Get a free estimate today. No pressure, no commitment.</p>
      <a href={`tel:${site.phoneTel}`} class="btn btn-primary">Call {site.phone}</a>
    </div>
  </section>
</Base>

<style>
  .sp-hero {
    background: var(--bg-dark);
    padding: 80px 0 88px;
    position: relative;
    overflow: hidden;
  }
  .sp-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 80%, rgba(61,107,61,0.1), transparent 55%);
  }
  .sp-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .sp-hero .container { position: relative; }
  .sp-hero .section-label { color: var(--warm); }
  .sp-hero h1 {
    font-size: clamp(34px, 4.5vw, 50px);
    color: var(--white);
    margin-bottom: 18px;
    max-width: 700px;
    font-weight: 600;
    letter-spacing: -0.3px;
  }
  .sp-hero-sub {
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    max-width: 580px;
    margin-bottom: 32px;
    line-height: 1.75;
    font-weight: 300;
  }
  .sp-hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .sp-hero .btn-secondary {
    border-color: rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.8);
  }

  .sp-content { padding: 80px 0 104px; }
  .sp-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 56px;
    align-items: start;
  }
  .sp-main h2 {
    font-size: 30px;
    margin-bottom: 18px;
    letter-spacing: -0.3px;
  }
  .sp-main > p {
    font-size: 16px;
    color: var(--text);
    line-height: 1.85;
    margin-bottom: 36px;
    font-weight: 300;
  }
  .sp-main h3 {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 18px;
    letter-spacing: -0.1px;
  }
  .sp-benefits {
    list-style: none;
    margin-bottom: 36px;
  }
  .sp-benefits li {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 400;
  }
  .benefit-dash {
    display: block;
    width: 14px;
    height: 1.5px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .sp-price-box {
    background: var(--accent-light);
    border: 1px solid rgba(61,107,61,0.1);
    border-radius: var(--radius-lg);
    padding: 28px;
    border-left: 3px solid var(--accent);
  }
  .sp-price-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-light);
    margin-bottom: 6px;
  }
  .sp-price-value {
    display: block;
    font-size: 30px;
    font-weight: 600;
    color: var(--accent);
    font-family: var(--font-display);
    margin-bottom: 8px;
  }
  .sp-price-note { font-size: 13px; color: var(--text-light); font-weight: 300; }

  /* Sidebar */
  .sidebar-cta {
    background: var(--bg-card);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 24px;
  }
  .sidebar-cta h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .sidebar-cta p { font-size: 14px; color: var(--text-light); margin-bottom: 16px; font-weight: 300; }
  .sidebar-services, .sidebar-areas {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 24px;
  }
  .sidebar-services h4, .sidebar-areas h4 {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 14px;
    color: var(--text-light);
  }
  .sidebar-services ul, .sidebar-areas ul { list-style: none; }
  .sidebar-services li, .sidebar-areas li {
    padding: 6px 0;
    font-size: 14px;
  }
  .sidebar-services a, .sidebar-areas a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 400;
  }
  .sidebar-services a:hover, .sidebar-areas a:hover { text-decoration: underline; }

  .sp-cta-bottom {
    background: var(--bg-dark);
    padding: 72px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .sp-cta-bottom::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }
  .sp-cta-bottom .container { position: relative; }
  .sp-cta-bottom h2 {
    color: var(--white);
    font-size: clamp(26px, 3.5vw, 38px);
    margin-bottom: 12px;
  }
  .sp-cta-bottom p {
    color: rgba(255,255,255,0.55);
    margin-bottom: 28px;
    font-weight: 300;
  }

  @media (max-width: 900px) {
    .sp-grid { grid-template-columns: 1fr; }
  }
</style>
